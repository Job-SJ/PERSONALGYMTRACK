# Supabase project URL and publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only together with confirmed email signups in Supabase Auth.
PGT_PUBLIC_REGISTRATION=false

# Optional server-only credential vault. Apply migrations before enabling it.
SUPABASE_SERVER_SECRET=
# JSON object mapping key versions to random 32-byte base64url keys.
INTEGRATION_KEYS=
INTEGRATION_ACTIVE_KEY=

# Legacy Hevy credentials, retained during migration only
HEVY_API_KEY=
# Supabase Auth user UUID for that account
HEVY_OWNER_ID=

# Optional contact included in the Open Food Facts API user agent
OPEN_FOOD_FACTS_CONTACT=
